    },
    "scripts": {
        "start": "pnpm run start:dev",
        "start:dev": "vite",
        "start:prod": "vite",
        "build:sw": "tsc && vite build --config vite.sw.config.ts",
        "build:prolog": "tsc && vite build --config vite.prolog.config.ts",
        "build:libs": "tsc && vite build --config vite.prolog.config.ts && vite build --config vite.tensorflow.config.ts",
        "build": "tsc && pnpm run build:sw && pnpm run build:libs && vite build",
        "build:main": "tsc && vite build",
        "deploy": "firebase deploy",
        "update:check": "ncu",
        "update:patch": "ncu -u -t patch",
        "update:minor": "ncu -u -t minor",
        "update:all": "ncu -u",
        "update:licenses": "license-checker --direct | sed -r '/(path|email|licenseFile):/d' > library_licenses",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview"
    },
